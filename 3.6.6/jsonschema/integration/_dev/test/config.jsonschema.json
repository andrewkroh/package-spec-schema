{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elastic.dev/package-spec/3.6.6/integration/_dev/test/config.jsonschema.json",
  "type": "object",
  "properties": {
    "asset": {
      "description": "Configuration for asset tests",
      "$ref": "#/definitions/config_tests"
    },
    "pipeline": {
      "description": "Configuration for pipeline tests",
      "$ref": "#/definitions/config_tests"
    },
    "policy": {
      "description": "Configuration for policy tests",
      "$ref": "#/definitions/policy_config_tests"
    },
    "static": {
      "description": "Configuration for static tests",
      "$ref": "#/definitions/config_tests"
    },
    "system": {
      "description": "Configuration for system tests",
      "$ref": "#/definitions/config_tests"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "config_tests": {
      "type": "object",
      "properties": {
        "parallel": {
          "description": "Tests defined can be run in parallel (default true).",
          "default": false,
          "type": "boolean"
        },
        "requires": {
          "description": "Package dependencies required for these tests with exact versions.",
          "type": "array",
          "items": {
            "$ref": "../../data_stream/_dev/test/config.jsonschema.json#/definitions/package_requirement"
          }
        },
        "skip": {
          "$ref": "../../data_stream/_dev/test/config.jsonschema.json#/definitions/skip"
        }
      },
      "additionalProperties": false
    },
    "policy_config_tests": {
      "type": "object",
      "properties": {
        "ignore_fields": {
          "description": "Stream-level field paths to strip before comparing the actual policy against the expected file. Paths use dot notation scoped to the stream level (e.g. \"state.user_agent\" strips inputs[].streams[].state.user_agent).\n",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parallel": {
          "$ref": "#/definitions/config_tests/properties/parallel"
        },
        "requires": {
          "$ref": "#/definitions/config_tests/properties/requires"
        },
        "skip": {
          "$ref": "#/definitions/config_tests/properties/skip"
        }
      },
      "additionalProperties": false
    }
  }
}
